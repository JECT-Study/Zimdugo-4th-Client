{
  "name": "admin",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ../../packages/i18n/project.inlang --outdir ./src/paraglide --emit-ts-declarations --silent",
    "predev": "pnpm run i18n:compile",
    "dev": "vite dev --port 3011",
    "prebuild": "pnpm run i18n:compile",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "pnpm run i18n:compile",
    "pretypecheck": "pnpm run i18n:compile",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@repo/i18n": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260410-164248-8ab58a4b",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.13.1",
    "@tanstack/devtools-vite": "^0.3.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
