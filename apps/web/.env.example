# 웹 앱 환경 변수 견본
#
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋되지 않는다(.gitignore).
# Vite 는 apps/web 을 기준으로 .env 를 읽으므로 위치를 옮기지 않는다.
#
#   cp apps/web/.env.example apps/web/.env
#
# VITE_ 접두사가 붙은 값은 번들에 그대로 박혀 브라우저에서 볼 수 있다.
# 비밀 값(서버 키, 토큰)은 여기 두지 않는다.
# 배포 환경 값은 Vercel 대시보드의 Environment Variables 에서 관리한다.

# ─────────────────────────────────────────────────────────────
# 지도 (네이버 지도 SDK)
# ─────────────────────────────────────────────────────────────

# 네이버 클라우드 플랫폼 Maps 의 Client ID(ncpKeyId).
# 없으면 지도가 아예 뜨지 않는다. 콘솔 > AI·NAVER API > Maps > 인증 정보.
VITE_NAVER_MAP_CLIENT_ID=

# 지도 디자인툴(Maps 스타일 에디터)에서 만든 스타일 ID.
#
# 콘솔 > Maps > 스타일 에디터에서 지도 색·라벨·POI 를 편집해 저장하면 발급된다.
# maps.js 를 부를 때 customStyleId 로 넘겨 그 스타일로 지도를 그린다.
#
# 비워 두면 네이버 기본 스타일로 뜬다. 지도 자체는 정상 동작하므로,
# 스타일을 아직 만들지 않았다면 비워 두면 된다.
#
# 스타일 ID 는 발급한 Client ID 에 묶여 있다. 다른 키로 만든 ID 를 넣으면
# 지도가 기본 스타일로 떨어지거나 인증에서 막힌다.
VITE_NAVER_MAP_CUSTOM_STYLE_ID=

# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────

# 백엔드 API 주소. 끝에 슬래시를 붙이지 않는다.
# 비우면 클라이언트는 상대 경로로 요청하고 경고를 남긴다. 서버 렌더링에서는
# 상대 경로로 부를 곳이 없어 요청이 막히므로, 로컬에서도 채워 두는 편이 낫다.
VITE_API_BASE_URL=https://api.zimdugo.com

# 빌드·서버에서만 쓰는 같은 값의 별칭(vite.config.ts).
# VITE_API_BASE_URL 을 채웠다면 둘 필요 없다.
# API_BASE_URL=

# ─────────────────────────────────────────────────────────────
# 업로드 (Oracle Object Storage)
# ─────────────────────────────────────────────────────────────
#
# 업로드 URL 이 우리가 아는 곳을 가리키는지 검사하는 데 쓴다. 셋 다 기본값이
# 코드에 있으므로(upload-file-to-upload-url.ts) 스토리지를 옮길 때만 채운다.

# VITE_UPLOAD_HOST=objectstorage.ap-osaka-1.oraclecloud.com
# VITE_UPLOAD_NAMESPACE=axuj36gr8lmm
# VITE_UPLOAD_BUCKET=zimdugo-bucket

# ─────────────────────────────────────────────────────────────
# 그 밖
# ─────────────────────────────────────────────────────────────

# Google Tag Manager 컨테이너 ID(GTM-XXXXXXX).
# 비우면 GTM 스크립트를 아예 붙이지 않는다. 로컬에서는 비워 두는 것을 권한다.
VITE_GTM_CONTAINER_ID=

# 설정 화면에 보이는 앱 버전. 비우면 1.0.0 으로 표시한다.
VITE_APP_VERSION=

# VITE_MANIFEST_USE_CREDENTIALS 는 직접 두지 않는다.
# Vercel 의 VERCEL_ENV 를 보고 빌드 시점에 vite.config.ts 가 넣어 준다.
